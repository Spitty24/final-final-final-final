{
 "multipart": [
  {
   "apply": {
    "model": "freerun:block/cubicle_wall_post"
   }
  },
  {
   "when": {
    "north": "true"
   },
   "apply": {
    "model": "freerun:block/cubicle_wall_side"
   }
  },
  {
   "when": {
    "east": "true"
   },
   "apply": {
    "model": "freerun:block/cubicle_wall_side",
    "y": 90
   }
  },
  {
   "when": {
    "south": "true"
   },
   "apply": {
    "model": "freerun:block/cubicle_wall_side_alt"
   }
  },
  {
   "when": {
    "west": "true"
   },
   "apply": {
    "model": "freerun:block/cubicle_wall_side_alt",
    "y": 90
   }
  },
  {
   "when": {
    "north": "false"
   },
   "apply": {
    "model": "freerun:block/cubicle_wall_noside"
   }
  },
  {
   "when": {
    "east": "false"
   },
   "apply": {
    "model": "freerun:block/cubicle_wall_noside_alt"
   }
  },
  {
   "when": {
    "south": "false"
   },
   "apply": {
    "model": "freerun:block/cubicle_wall_noside_alt",
    "y": 90
   }
  },
  {
   "when": {
    "west": "false"
   },
   "apply": {
    "model": "freerun:block/cubicle_wall_noside",
    "y": 270
   }
  }
 ]
}